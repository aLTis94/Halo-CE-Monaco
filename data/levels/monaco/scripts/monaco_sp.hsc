
(global short modulo_tmp 0)
(global boolean finished false)
(global unit winner_player none)
(global cutscene_flag player0_last_checkpoint a8)
(global cutscene_flag player1_last_checkpoint a8)
(global long timer_minutes 0)
(global long timer_seconds 0)
(global long race_start_minutes 0)
(global long race_start_seconds 0)
(global long race_start_minutes1 0)
(global long race_start_seconds1 0)
(global long race_finish_minutes 0)
(global long race_finish_seconds 0)
(global long best_lap_time 10000000)

(script startup setup_checkpoints
	(sleep_forever checkpoints_a_player0)
	(sleep_forever checkpoints_a_player1)
	(sleep_forever timer)
	(sleep_forever real_timer)
	(sleep 30)
	(if (= is_mp 0)
		(begin
			(wake real_timer)
			(sp_race)
		)
	)
)

(script static void sp_race
	(object_create_containing car)
	(player_enable_input false)
	(sound_impulse_start "levels\monaco\sound\gentlemen_start_your_engines" none 1)
	
	(if (!= (player0) none) (object_teleport car0 spawn0))
	(vehicle_load_magic car0 "" (player0))
	(if (!= (player1) none) (object_teleport car1 spawn1))
	(vehicle_load_magic car1 "" (player1))

	(sleep 160)
	(print "3 2 1")
	(sound_impulse_start "levels\monaco\sound\race_start" none 1)
	(object_create red_light5)
	(sleep 30)
	(object_create red_light4)
	(sleep 30)
	(object_create red_light3)
	(sleep 30)
	(object_create red_light2)
	(sleep 30)
	(object_create red_light1)
	
	(sleep 50)
	(print "gooo")
	(player_enable_input true)
	(object_destroy_containing red_light)
	
	(wake timer)
	(wake checkpoints_a_player0)
	(wake checkpoints_a_player1)
)

(script continuous checkpoints_a_player0
	(print "should start the A...")
	(checkpoints_a 0)
)

(script continuous checkpoints_a_player1
	(if (= (game_is_cooperative) false) (sleep_forever))
	(print "should start the A... FOR COOP!!!!!!")
	(checkpoints_a 1)
)

(script static void (checkpoint (cutscene_flag checkpoint_flag) (short id) (boolean finish_line))
	(activate_nav_point_flag "flag_blue" (unit (list_get (players) id)) checkpoint_flag 0)
	(sleep_until (or finished (and (> (unit_get_health (unit (list_get (players) id))) 0) (< (objects_distance_to_flag (unit (list_get (players) id)) checkpoint_flag) 5.5))) 1)
	
	(deactivate_nav_point_flag (unit (list_get (players) id)) checkpoint_flag)
	(if (= id 0) (set player0_last_checkpoint checkpoint_flag) (set player1_last_checkpoint checkpoint_flag))
	(if (= finished false)
		(if finish_line
			(finish id)
			(sound_impulse_start "sound\sfx\ui\countdown_timer" "none" 1)
		)
	)
)

(script static void (finish (short id))
	(if (= id 0) (set race_finish_minutes (- timer_minutes race_start_minutes)) (set race_finish_minutes (- timer_minutes race_start_minutes1)))
	(if (= id 0) (set race_finish_seconds (- timer_seconds race_start_seconds)) (set race_finish_seconds (- timer_seconds race_start_seconds1)))
	(print "Finish!")
	(print "Player:")
	(inspect id)
	(print "Minutes:")
	(inspect race_finish_minutes)
	(print "Seconds:")
	(inspect race_finish_seconds)
	;(set winner_player (unit (list_get (players) id)))
	(sound_impulse_start "sound\sfx\ui\teleporter_fatal_coexistence" "none" 1)
	(if (> best_lap_time (+ race_finish_seconds (* race_finish_minutes 60)))
		(begin
			(print "new best lap time!")
			(numeric_countdown_timer_restart)
			(numeric_countdown_timer_set (* (+ race_finish_seconds (* race_finish_minutes 60)) 1000) false)
			(set best_lap_time (+ race_finish_seconds (* race_finish_minutes 60)))
			(sound_impulse_start "levels\monaco\sound\new_lap_record" "none" 1)
		)
	)
)

(script static void (checkpoints_a (short id))
	
	(if (= id 0) (set race_start_minutes timer_minutes) (set race_start_minutes1 timer_minutes))
	(if (= id 0) (set race_start_seconds (+ timer_seconds 1)) (set race_start_seconds1 (+ timer_seconds 1)))
	(if (= id 0) (hud_set_timer_position 0 0 bottom_right))
	(if (= id 0) (hud_set_timer_time 0 0))
	;(wake timer)
	
	(checkpoint a1 id false)
	(print "a1")
	(checkpoint a2 id false)
	(print "a2")
	(checkpoint a3 id false)
	(print "a3")
	(checkpoint a4 id false)
	(print "a4")
	(checkpoint a5 id false)
	(print "a5")
	(checkpoint a6 id false)
	(print "a6")
	(checkpoint a7 id false)
	(print "a7")
	(checkpoint a8 id false)
	(print "a8")
	(checkpoint a9 id false)
	(print "a9")
	(checkpoint a10 id false)
	(print "a10")
	(checkpoint a11 id false)
	(print "a11")
	(checkpoint a12 id false)
	(print "a12")
	(checkpoint a0 id true)
	(print "a0")
)

(script continuous timer
	(sleep 1)
	(hud_set_timer_time (- timer_minutes race_start_minutes) (- timer_seconds race_start_seconds))
	(pause_hud_timer true)
)

(script continuous real_timer
	(set timer_minutes (modulo (/ (game_time_authoritative) 1800) 60))
	(set timer_seconds (modulo (/ (game_time_authoritative) 30) 60))
)

(script static short (modulo (short x) (short y))
  (set modulo_tmp (/ x y))
  (- x (* modulo_tmp y))
)