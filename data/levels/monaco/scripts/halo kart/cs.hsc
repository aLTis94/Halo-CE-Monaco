;; Intro cutscene for the grand prix
(script static boolean (volume_hack (real GAIN))
	(sound_class_set_gain "projectile_impact" GAIN 1)
	(sound_class_set_gain "projectile_detonation" GAIN 1)
	(sound_class_set_gain "weapon_fire" GAIN 1)
	(sound_class_set_gain "weapon_ready" GAIN 1)
	(sound_class_set_gain "weapon_reload" GAIN 1)
	(sound_class_set_gain "weapon_empty" GAIN 1)
	(sound_class_set_gain "weapon_charge" GAIN 1)
	(sound_class_set_gain "weapon_overheat" GAIN 1)
	(sound_class_set_gain "weapon_idle" GAIN 1)
	(sound_class_set_gain "object_impacts" GAIN 1)
	(sound_class_set_gain "particle_impacts" GAIN 1)
	(sound_class_set_gain "slow_particle_impacts" GAIN 1)
	(sound_class_set_gain "unit_footsteps" GAIN 1)
	(sound_class_set_gain "vehicle_collision" GAIN 1)
	(sound_class_set_gain "vehicle_engine" GAIN 1)
	(sound_class_set_gain "music" 1 1)           ;; Don't 
	(sound_class_set_gain "ambient_nature" GAIN 1)
	(sound_class_set_gain "ambient_machinery" GAIN 1)
	(sound_class_set_gain "ambient_computers" GAIN 1)
	(sound_class_set_gain "first_person_damage" GAIN 1)
	(sound_class_set_gain "game_event" GAIN 1)
false
)

(global unit ai_spark none)

(script static boolean cs
	;; Cutscene time! Init all the stuffs
	(player_enable_input false)
	(player_camera_control false)
	(fade_out 1 1 1 0)
	(cinematic_start)
	(camera_control_tracked 1)
	(sleep 5)
	(volume_hack 0.4)

	(fade_in 1 1 1 20)
	(cinematic_screen_effect_start 1)
	(cinematic_screen_effect_set_convolution 3 2 55 0.1 3)
	(camera_set cs0_00 0)
	(camera_set cs0_01 200)
	(scenery_animation_start item09 "kart\scenery\item block\d\d" "idle")

	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.5)
	(sleep 15)
	(object_create cs_chief)
	(effect_new_on_object_marker "effects\coop teleport" cs_chief "")
	(recording_play cs_chief cs_chief00)
	(sleep 15)
	(object_create cs_spark)
	(effect_new "effects\coop teleport" cs_tele_spark)
	(sleep 90)

	(cinematic_screen_effect_stop)
	(sound_impulse_start "levels\c30\dialog\spark00" cs_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark00") 10))

	(sound_impulse_start "levels\c30\dialog\chief00" cs_chief 0.75)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\chief00") 10))

	(sound_impulse_start "levels\c30\dialog\spark01" cs_spark 1)
	(camera_set cs0_02 100)
	(recording_kill cs_chief) (sleep 1)
	(recording_play cs_chief cs_chief01)
	(sleep (sound_impulse_time "levels\c30\dialog\spark01"))

	(sound_impulse_start "levels\c30\dialog\chief01" cs_chief 0.75)
	(sleep (- (sound_impulse_time "levels\c30\dialog\chief01") 15))

	(sound_impulse_start "levels\c30\dialog\spark02" cs_spark 1)
	(camera_set cs0_03 0)
	(scenery_animation_start item09 "kart\scenery\item block\d\d" "idle")
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark02") 5))

	(recording_kill cs_chief) (sleep 1)
	(recording_play cs_chief cs_chief02)
	(camera_set cs0_04 0)
	(camera_set cs0_05 200)
	(scenery_animation_start item09 "kart\scenery\item block\d\d" "idle")
	(sound_impulse_start "levels\c30\dialog\spark03" cs_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark03") 5))
	(sound_impulse_start "levels\c30\dialog\spark04" cs_spark 1)
	(sleep (- (sound_impulse_time "levels\c30\dialog\spark04") 45))
	(recording_play cs_spark cs_spark00)
	(sleep 50)
	(object_destroy cs_spark)
	(object_destroy cs_chief)

	;; Introduction section of cutscenes
	(ai_place_tracked cs_spark)
	(ai_command_list cs_spark cs_spark)
	(set ai_spark (unit (list_get (ai_actors cs_spark) 0)))
	(music "kart\music\setup" 1750)
	

	;; Intro 00 - Grunts
	(camera_set cs1_00 0)
	(sleep 10)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh00)
	(effect_new "effects\coop teleport" cs_tele00)
	(sleep 10)
	(object_create cs_grunt0)
	(unit_set_seat cs_grunt0 "alert")
	(custom_animation cs_grunt0 "characters\grunt\grunt" "stand pistol surprise-front" true)
	(effect_new_on_object_marker "effects\coop teleport" cs_grunt0 "")
	(sleep 10)
	(object_create cs_grunt1)
	(custom_animation cs_grunt1 "characters\grunt\grunt" "asleep pistol idle%1" false)
	(effect_new_on_object_marker "effects\coop teleport" cs_grunt1 "")
	(sound_impulse_start "levels\c30\dialog\spark05" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark05") 15))

	;; Intro 01 - Marines
	(ai_command_list_advance cs_spark)
	(camera_set cs1_01 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh01)
	(effect_new "effects\coop teleport" cs_tele01)
	(sleep 10)
	(object_create cs_marine0)
	(unit_set_seat cs_marine0 "crouch")
	(effect_new_on_object_marker "effects\coop teleport" cs_marine0 "")
	(sleep 10)
	(object_create cs_marine1)
	(unit_set_seat cs_marine1 "alert")
	(effect_new_on_object_marker "effects\coop teleport" cs_marine1 "")
	(sound_impulse_start "levels\c30\dialog\spark06" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark06") 15))

	;; Intro 02 - Jackals
	(ai_command_list_advance cs_spark)
	(camera_set cs1_02 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh02)
	(effect_new "effects\coop teleport" cs_tele02)
	(sleep 10)
	(object_create cs_jackal0)
	(unit_set_seat cs_jackal0 "crouch")
	(effect_new_on_object_marker "effects\coop teleport" cs_jackal0 "")
	(sleep 10)
	(object_create cs_jackal1)
	(unit_set_seat cs_jackal1 "alert")
	(effect_new_on_object_marker "effects\coop teleport" cs_jackal1 "")
	(sound_impulse_start "levels\c30\dialog\spark07" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark07") 15))

	;; Intro 03 - Keyes
	(ai_command_list_advance cs_spark)
	(camera_set cs1_03 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh03)
	(effect_new "effects\coop teleport" cs_tele03)
	(sleep 10)
	(object_create cs_keyes0)
	(effect_new_on_object_marker "effects\coop teleport" cs_keyes0 "")
	(sleep 10)
	(object_create cs_keyes1)
	(recording_play cs_keyes1 cs_keyes00)
	(effect_new_on_object_marker "effects\coop teleport" cs_keyes1 "")
	(sound_impulse_start "levels\c30\dialog\spark08" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark08") 15))

	;; Intro 04 - Elites
	(ai_command_list_advance cs_spark)
	(camera_set cs1_04 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh04)
	(effect_new "effects\coop teleport" cs_tele04)
	(sleep 10)
	(object_create cs_elite0)
	(unit_set_seat cs_elite0 "alert")
	(effect_new_on_object_marker "effects\coop teleport" cs_elite0 "")
	(sleep 10)
	(object_create cs_elite1)
	(unit_set_seat cs_elite1 "crouch")
	(effect_new_on_object_marker "effects\coop teleport" cs_elite1 "")
	(sound_impulse_start "levels\c30\dialog\spark09" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark09") 15))

	;; Intro 05 - Marines 2
	(ai_command_list_advance cs_spark)
	(camera_set cs1_05 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh05)
	(effect_new "effects\coop teleport" cs_tele05)
	(sleep 10)
	(object_create cs_marine2)
	(effect_new_on_object_marker "effects\coop teleport" cs_marine2 "")
	(sleep 10)
	(object_create cs_marine3)
	(unit_kill cs_marine3)
	(effect_new_on_object_marker "effects\coop teleport" cs_marine3 "")
	(sound_impulse_start "levels\c30\dialog\spark10" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark10") 15))

	;; Intro 06 - Infections
	(ai_command_list_advance cs_spark)
	(camera_set cs1_06 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh06)
	(effect_new "effects\coop teleport" cs_tele06)
	(sleep 10)
	(sound_impulse_start "levels\c30\dialog\spark11" ai_spark 1)
	(object_create cs_infection0) (sleep 10)
	(object_create cs_infection1) (sleep 10)
	(object_create cs_infection2) (sleep 10)
	(object_create cs_infection3) (sleep 10)
	(object_create cs_infection4) (sleep 16)
	(object_create cs_infection5) (sleep 19)
	(object_create cs_infection6) (sleep 30)
	(sleep 25)

	;; Intro 07 - Crewmen
	(ai_command_list_advance cs_spark)
	(camera_set cs1_07 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh07)
	(effect_new "effects\coop teleport" cs_tele07)
	(sleep 10)
	(object_create cs_crew0)
	(effect_new_on_object_marker "effects\coop teleport" cs_crew0 "")
	(sleep 10)
	(object_create cs_crew1)
	(effect_new_on_object_marker "effects\coop teleport" cs_crew1 "")
	(custom_animation cs_crew1 "characters\marine\marine" "stand_unarmed_act-wave" true)
	(sound_impulse_start "levels\c30\dialog\spark12" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark12") 15))

	;; Intro 08 - Hunters
	(ai_command_list_advance cs_spark)
	(camera_set cs1_08 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh08)
	(effect_new "effects\coop teleport" cs_tele08)
	(sleep 10)
	(object_create cs_hunter0)
	(effect_new_on_object_marker "effects\coop teleport" cs_hunter0 "")
	(sleep 10)
	(object_create cs_hunter1)
	(effect_new_on_object_marker "effects\coop teleport" cs_hunter1 "")
	(sound_impulse_start "levels\c30\dialog\spark13" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark13") 15))

	;; Intro 09 - Flood
	(ai_command_list_advance cs_spark)
	(camera_set cs1_09 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh09)
	(effect_new "effects\coop teleport" cs_tele09)
	(sleep 10)
	(object_create cs_flood0)
	(effect_new_on_object_marker "effects\coop teleport" cs_flood0 "")
	(sleep 10)
	(object_create cs_flood1)
	(effect_new_on_object_marker "effects\coop teleport" cs_flood1 "")
	(sound_impulse_start "levels\c30\dialog\spark14" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark14") 15))

	;; Intro 10 - Dante
	(ai_command_list_advance cs_spark)
	(camera_set cs1_10 30)
	(sleep 30)
	(sound_impulse_start "sound\sinomatixx_foley\teleportation_short" none 0.4)
	(object_create cs_veh10)
	(effect_new "effects\coop teleport" cs_tele10)
	(sleep 10)
	(object_create cs_dante)
	(unit_set_seat cs_dante "alert")
	(effect_new_on_object_marker "effects\coop teleport" cs_dante "")
	(sleep 10)
	(object_create cs_goku)
	(effect_new_on_object_marker "effects\coop teleport" cs_goku "")
	(custom_animation cs_goku "characters\marine\marine" "stand rifle berserk%3" true)
	(sound_impulse_start "levels\c30\dialog\spark15" ai_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark15") 15))

	;; Wrap up
	(object_create cs_spark)
	(object_teleport cs_spark cs_spark_02)
	(camera_set cs2_00 0)
	(sound_impulse_start "levels\c30\dialog\spark16" cs_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark16") 15))

	;; Cutscene over. Delete all the things!
	(fade_out 0 0 0 30)
	(sleep 30)
	(object_destroy_containing "cs_")
	(ai_erase cs_spark)
	(garbage_collect_now)             ;; Erase dead body of keyes and that marine
	(volume_hack 1.0)
false
)

(script static boolean cs_rec_ani00
	(sound_impulse_start "levels\c30\dialog\spark03" cs_spark 1)
	(sleep (+ (sound_impulse_time "levels\c30\dialog\spark03") 5))
	(sound_impulse_start "levels\c30\dialog\spark04" cs_spark 1)
	(sleep (- (sound_impulse_time "levels\c30\dialog\spark04") 45))
	(recording_play cs_spark cs_spark00)
	(sleep 50)
false
)